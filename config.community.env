# Portable defaults for Agent Chat Community Edition.
# The macOS installer copies this into the user's Application Support directory,
# generates the access token, and fills in user-selected values.

AGENT_CHAT_EDITION=community
USER_DISPLAY_NAME=Owner
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:8086
AGENT_CHAT_GITHUB_REPO_URL=https://github.com/agents-chat/agents-chat

REQUIRE_AUTH=1
COMMUNITY_FIRST_RUN_SETUP=1
ORCHESTRATOR_ACCESS_TOKEN=GENERATED_BY_INSTALLER
ORCHESTRATOR_ADMIN_EMAIL=admin@localhost
ORCHESTRATOR_ADMIN_PASSWORD=
ORCHESTRATOR_ADMIN_NAME=Owner
ORCHESTRATOR_ADMIN_PREFERRED_NAME=Owner
AUTH_SESSION_DAYS=30

# Local HTTP requires a non-Secure cookie. Change this to 1 only when Agent Chat
# is served exclusively through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=0
ALLOWED_ORIGINS=http://127.0.0.1:8086,http://localhost:8086

AGENT_TIMEOUT_S=900
PROGRESS_POLL_INTERVAL_S=1.0
MAX_UPLOAD_BYTES=26214400
STATIC_CACHE_SECONDS=604800
ASSET_CACHE_SECONDS=31536000
LOG_LEVEL=INFO

# DATA_DIR and STORAGE_DB are set by the platform launcher. Do not hard-code a
# username or installation directory here.
DATA_DIR=
STORAGE_DB=

# Optional local bridges. Leave their tokens blank until configured.
AGENT_TOKEN_CODEX=
CODEX_AGENT_URL=http://127.0.0.1:55009/api/api_message
AGENT_TOKEN_CLAUDE=
CLAUDE_AGENT_URL=http://127.0.0.1:55010/api/api_message
AGENT_TOKEN_HERMES=
HERMES_AGENT_URL=http://127.0.0.1:55011/api/api_message
AGENT_TOKEN_MINIMAX=
MINIMAX_AGENT_URL=http://127.0.0.1:55012/api/api_message
AGENT_TOKEN_ANTIGRAVITY=
ANTIGRAVITY_AGENT_URL=http://127.0.0.1:55014/api/api_message
AGENT_TOKEN_GROK=
GROK_AGENT_URL=http://127.0.0.1:55019/api/api_message
AGENT_TOKEN_OPENROUTER=
OPENROUTER_API_KEY=
OPENROUTER_AGENT_URL=http://127.0.0.1:55024/api/api_message
OPENROUTER_BRIDGE_MODEL=openrouter/free
OPENROUTER_BRIDGE_REASONING=default

# Optional OpenAI-powered voice features.
# To enable paid OpenAI API voice features, add OPENAI_API_KEY to your private
# installed config.env. Community Edition does not include or require a key.
VOICE_ENABLED=1
VOICE_TRANSCRIPTION_MODEL=gpt-realtime-whisper
VOICE_TTS_MODEL=gpt-4o-mini-tts

# Support email and outbound integrations are off until the owner deliberately
# configures them.
SUPPORT_EMAIL_ENABLED=0
OPERATIONAL_SECRET_AUTO_SYNC=0
# Credentialed mail and DAV connections must resolve to public addresses by
# default. Set this to 1 only when intentionally connecting to a trusted server
# on the owner's private network.
AGENT_CHAT_ALLOW_PRIVATE_INTEGRATION_HOSTS=0
